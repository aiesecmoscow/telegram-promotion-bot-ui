{
  "name": "promotion-bot-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:css & bun --hot server.ts",
    "dev:css": "bunx @tailwindcss/cli -i ./src/index.css -o ./index.css --watch",
    "check": "tsc -b",
    "build:css": "bunx @tailwindcss/cli -i ./src/index.css -o ./index.css --minify",
    "build": "bun run check && bun run build:css && bun build ./index.html --outdir ./dist --minify --target browser",
    "start": "bun run server.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/cli": "^4.0.0",
    "@types/bun": "^1.3.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "daisyui": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}